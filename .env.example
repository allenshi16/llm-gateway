NODE_ENV=development
DATABASE_URL=postgresql://gateway:gateway@localhost:15432/gateway
REDIS_URL=redis://localhost:16379
CONTROL_PLANE_PORT=4100
EDGE_PORT=4000
CONSOLE_PORT=4200
LITELLM_URL=http://localhost:4302
EDGE_ENABLE_DISPATCH=false
EDGE_PROVIDER_TIMEOUT_MS=120000
LITELLM_MASTER_KEY=replace-with-a-private-litellm-master-key
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:replace-with-registry-verified-digest
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
CONTROL_PLANE_ADMIN_TOKEN=replace-with-a-random-bootstrap-admin-token
INTERNAL_ASSERTION_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_ASSERTION_ISSUER=gateway-edge
INTERNAL_ASSERTION_AUDIENCE=litellm-us
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT_NAME=llm_usage
# Base URL Stripe Checkout redirects the browser back to after payment.
CONSOLE_BASE_URL=http://127.0.0.1:4301
# Set STRIPE_SECRET_KEY to enable real Checkout; without it, billing/checkout
# activates a dev subscription and billing/dev-credit is available locally.
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:4301/login
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4300
# E2E defaults; override when running the suite against deployed environments.
E2E_WEB_URL=http://127.0.0.1:4300
E2E_CONSOLE_URL=http://127.0.0.1:4301
# new|legacy|canary. Frontend release switch used by the edge/load balancer to
# route console traffic between apps/console-web (new) and apps/console (legacy).
CONSOLE_RELEASE_TARGET=legacy
