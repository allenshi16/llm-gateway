{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@gateway/*' build",
    "dev:control-plane": "bun --env-file=.env run --filter '@gateway/control-plane' dev",
    "dev:edge": "bun --env-file=.env run --filter '@gateway/edge' dev",
    "dev:worker": "bun --env-file=.env run --filter '@gateway/worker' dev",
    "dev:console": "bun --env-file=.env run --filter '@gateway/console' dev",
    "dev:web": "bun --env-file=.env run --filter '@gateway/web' dev",
    "dev:console-web": "bun --env-file=.env run --filter '@gateway/console-web' dev",
    "typecheck": "bun run --filter '@gateway/*' typecheck",
    "test": "vitest run --passWithNoTests",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run packages/database/src/*integration.test.ts apps/worker/src/*integration.test.ts apps/control-plane/src/*integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:migrate:sql": "bun run --filter '@gateway/database' db:migrate:sql",
    "release:check": "tsx packages/core/src/release-check.ts",
    "release:image:verify": "./scripts/release-image-verify.sh",
    "plans:list": "bun run --filter '@gateway/core' plans:list",
    "plans:config": "bun run --filter '@gateway/core' plans:config",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker-compose.yml down",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.59.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "pg": "^8.16.3",
    "@fastify/cors": "^11.0.1",
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.5.0",
    "jose": "^6.1.0",
    "ioredis": "^6.0.0",
    "stripe": "^22.4.0",
    "zod": "^4.4.3",
    "next": "15.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
